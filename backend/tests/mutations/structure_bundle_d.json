{
  "description": "SLS v1.0.20 §3.5/§3.6, the Bundle D structure rules (M1). Each mutation removes or widens one rule; the named tests must notice. Run from backend/: uv run python -m tests.support.mutation_battery tests/mutations/structure_bundle_d.json",
  "pytest": [
    "tests/unit/application/detection/test_choch_bundle_d.py",
    "tests/unit/domain/structure/test_leg.py",
    "tests/unit/application/detection/test_structure_shift_replay.py",
    "tests/property/test_structure_shift_resumes.py"
  ],
  "mutations": [
    {
      "name": "CHoCH ignores epsilon downward",
      "file": "backend/src/scanner/application/detection/structure_shift_replay.py",
      "old": "        if candle.close >= swing.price - epsilon:",
      "new": "        if candle.close >= swing.price:",
      "expect_failing": [
        "test_a_close_inside_epsilon_is_not_a_choch"
      ]
    },
    {
      "name": "CHoCH ignores epsilon upward",
      "file": "backend/src/scanner/application/detection/structure_shift_replay.py",
      "old": "        if candle.close <= swing.price + epsilon:",
      "new": "        if candle.close <= swing.price:",
      "expect_failing": [
        "test_epsilon_applies_upward_in_a_bearish_trend"
      ]
    },
    {
      "name": "epsilon becomes inclusive",
      "file": "backend/src/scanner/application/detection/structure_shift_replay.py",
      "old": "        if candle.close >= swing.price - epsilon:",
      "new": "        if candle.close > swing.price - epsilon:",
      "expect_failing": [
        "test_a_close_exactly_epsilon_away_is_not_a_choch"
      ]
    },
    {
      "name": "the walk passes no epsilon",
      "file": "backend/src/scanner/application/detection/structure_shift_replay.py",
      "old": "                epsilon=TOLERANCE_ATR * atr if atr is not None else _ZERO,",
      "new": "                epsilon=_ZERO,",
      "expect_failing": [
        "test_the_walk_applies_epsilon_from_the_window_atr"
      ]
    },
    {
      "name": "CHoCH ignores surpassed levels",
