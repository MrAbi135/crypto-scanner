      "old": "    return before[-2] if len(before) >= 2 else current",
      "new": "    return before[-1] if len(before) >= 2 else current",
      "expect_failing": [
        "test_the_fallback_start_is_the_second_most_recent_labelled_swing"
      ]
    },
    {
      "name": "the extreme includes the current candle",
      "file": "backend/src/scanner/domain/structure/leg.py",
      "old": "    extreme = _highest(highs, start, current - 1) if bullish else _lowest(lows, start, current - 1)",
      "new": "    extreme = _highest(highs, start, current) if bullish else _lowest(lows, start, current)",
      "expect_failing": [
        "test_the_extreme_is_read_from_candles_before_the_current_one"
      ]
    },
    {
      "name": "the turning CHoCH is ignored",
      "file": "backend/src/scanner/application/detection/structure_shift_replay.py",
      "old": "    if turning is not None and turning.trend is trend and turning.choch_at < candle.open_time:",
      "new": "    if False:",
      "expect_failing": [
        "test_the_trend_start_comes_from_the_turning_choch"
      ]
    },
    {
      "name": "a turning CHoCH toward the other trend is used",
      "file": "backend/src/scanner/application/detection/structure_shift_replay.py",
      "old": "    if turning is not None and turning.trend is trend and turning.choch_at < candle.open_time:",
      "new": "    if turning is not None and turning.choch_at < candle.open_time:",
      "expect_failing": [
        "test_a_choch_toward_the_other_trend_falls_back_to_the_labelled_swings"
      ]
    },
    {
      "name": "the leg's carried candles are dropped on resume",
      "file": "backend/src/scanner/application/detection/structure_shift_replay.py",
      "old": "        before = [entry for entry in carried if entry[0] < candles[0].open_time]",
      "new": "        before = []",
      "expect_failing": [
        "test_a_sliding_window_that_resumes_leaves_one_pass_history"
      ]
    },
    {
      "name": "the leg's start is not resumed",
      "file": "backend/src/scanner/application/detection/structure_shift_replay.py",
      "old": "            leg = resumed.leg\n",
      "new": "",
      "expect_failing": [
        "test_a_sliding_window_that_resumes_leaves_one_pass_history"
      ]
    },
    {
      "name": "the last CHoCH is not resumed",
      "file": "backend/src/scanner/application/detection/structure_shift_replay.py",
      "old": "            turning = resumed.turning\n",
      "new": "",
      "expect_failing": [
        "test_a_sliding_window_that_resumes_leaves_one_pass_history"
      ]
    },
    {
      "name": "the leg survives a change of trend",
      "file": "backend/src/scanner/application/detection/structure_shift_replay.py",
      "old": "            if leg is None or leg.trend is not machine.state:",
      "new": "            if leg is None:",
      "expect_failing": [
        "test_a_sliding_window_that_resumes_leaves_one_pass_history"
      ]
    }
  ]
}
