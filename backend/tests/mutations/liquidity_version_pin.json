      "old": "            end,\n            only_version=LIQUIDITY_ALGO_VERSION,",
      "new": "            end,",
      "expect_failing": [
        "test_the_origin_sweep_is_read_from_the_running_liquidity_version_only"
      ]
    },
    {
      "name": "the chart draws every generation of pools",
      "file": "backend/src/scanner/interfaces/api/coins.py",
      "old": "parsed, only_version=LIQUIDITY_ALGO_VERSION)",
      "new": "parsed)",
