{
  "description": "Each candle decided once (audit M3, owner ruling 2026-09-14): participation s7-participation-v3, ict s6-v6, ote s6-ote-v6, ob s6-ob-v8, liquidity s5-v14 record the last candle a pass decided and create facts only after it. Each mutation removes one engine's floor or breaks the shared marker. Deterministic tests, so one battery run is a verdict. Run from backend/: uv run python -m tests.support.mutation_battery tests/mutations/decide_candles_once.json",
  "pytest": [
    "tests/unit/application/detection/test_participation_replay.py",
    "tests/unit/application/detection/test_ict_replay_coverage.py",
    "tests/unit/application/detection/test_bpr_parent_state_defect.py",
    "tests/unit/application/detection/test_ict_ote_replay.py",
    "tests/unit/application/detection/test_liquidity_version_pin.py"
  ],
  "mutations": [
    {
      "name": "participation decides the whole window again",
      "file": "backend/src/scanner/application/detection/participation_replay.py",
      "old": "        for index in range(first_index, len(series)):",
      "new": "        for index in range(0, len(series)):",
      "expect_failing": [
        "test_a_candle_already_decided_is_not_decided_again"
      ]
    },
    {
      "name": "a gap on an already decided candle is created again",
      "file": "backend/src/scanner/application/detection/ict_replay.py",
      "old": "            if index < first_index:\n                continue\n\n            await self._zones.upsert(",
      "new": "            if False:\n                continue\n\n            await self._zones.upsert(",
      "expect_failing": [
        "test_a_gap_on_an_already_decided_candle_is_not_created_again"
      ]
    },
    {
      "name": "a BPR composes on an already decided candle",
      "file": "backend/src/scanner/application/detection/ict_replay.py",
      "old": "if current_index < max(first_index, 0) or current_index >= len(candles):",
      "new": "if current_index < 0 or current_index >= len(candles):",
      "expect_failing": [
        "test_a_bpr_composes_only_while_its_newer_gap_is_undecided"
      ]
    },
    {
      "name": "an order block on an already decided displacement is created again",
      "file": "backend/src/scanner/application/detection/ict_ob_replay.py",
      "old": "            if displacement.candle_index + 1 < first_index:\n                continue",
      "new": "            if False:\n                continue",
      "expect_failing": [
        "test_an_order_block_on_an_already_decided_candle_is_not_created_again"
      ]
    },
    {
      "name": "an OTE on an already decided candle is created again",
      "file": "backend/src/scanner/application/detection/ict_ote_replay.py",
      "old": "        for index in range(first_index, len(candles)):",
      "new": "        for index in range(0, len(candles)):",
      "expect_failing": [
        "test_an_ote_on_an_already_decided_candle_is_not_created_again"
      ]
    },
    {
      "name": "a pool is born on an already decided candle",
      "file": "backend/src/scanner/application/detection/liquidity_replay.py",
      "old": "        if confirmed < self._decided_before and pool_id not in self._known:\n            return",
      "new": "        if False:\n            return",
      "expect_failing": [
        "test_no_pool_is_born_on_a_candle_an_earlier_pass_decided"
      ]
    },
    {
      "name": "the last decided candle is never recorded",
      "file": "backend/src/scanner/application/detection/state.py",
      "old": "    if state is None or not candles:\n        return",
      "new": "    if True:\n        return",
      "expect_failing": [
        "test_a_candle_already_decided_is_not_decided_again"
      ]
    },
    {
      "name": "a recorded candle is never read back",
      "file": "backend/src/scanner/application/detection/state.py",
      "old": "        if candle.open_time == decided:\n            return index + 1",
      "new": "        if candle.open_time == decided:\n            return 0",
      "expect_failing": [
        "test_a_candle_already_decided_is_not_decided_again",
        "test_a_gap_on_an_already_decided_candle_is_not_created_again",
        "test_an_order_block_on_an_already_decided_candle_is_not_created_again",
        "test_an_ote_on_an_already_decided_candle_is_not_created_again",
        "test_no_pool_is_born_on_a_candle_an_earlier_pass_decided"
      ]
    }
  ]
}
