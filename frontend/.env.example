# Frontend build-time env (Vite). Only VITE_-prefixed vars reach the bundle.
# Read exclusively through src/shared/config/env.ts (S0.3 §4). Copy to
# frontend/.env.local for local overrides (gitignored).

VITE_API_BASE=/api                 # API origin (dev uses the vite proxy)
VITE_SENTRY_DSN=                   # empty = Sentry disabled (dev default)
VITE_RELEASE=local                # release SHA; injected at image build
