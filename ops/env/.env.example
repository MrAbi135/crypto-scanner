# =============================================================================
# Environment variable catalog (S0.1 guide §13). THE source of truth for which
# variables exist. A variable not listed here does not exist (drift-proofing).
#
#   Naming law:     SCANNER_<AREA>_<NAME>   (greppable, collision-proof)
#   Per process:    each process validates ONLY the vars it declares (TAD §14);
#                   a missing/invalid var aborts boot with a field-precise error.
#   Usage:          `scripts/bootstrap.sh` copies this to ops/env/dev.env
#                   (gitignored) for local real values. Secrets in staging/prod
#                   arrive via SOPS-decrypted injection, never a committed file.
#
# Values below are DUMMIES. "Consumed by" lists the process(es) that read each.
# "[Sx]" marks a variable whose consuming code lands in a later sprint.
# =============================================================================

# --- Core (all processes) --------------------------------------------------
SCANNER_ENV=dev                         # dev|staging|prod              (all)
SCANNER_LOG_LEVEL=INFO                   # DEBUG|INFO|WARNING|ERROR      (all)
SCANNER_RELEASE=local                    # release SHA; set by deploy    (all) [S0.3]

# --- api process ------------------------------------------------------------
SCANNER_API_PORT=8000                    # api: bind port (serves /internal/*) (api)

# --- health server (non-api processes; compose overrides per service) --------
SCANNER_HEALTH_PORT=8001                  # ingest/engine/worker: internal health/metrics port

# --- Database: PostgreSQL 16 + TimescaleDB (TDR §8) -------------------------
SCANNER_DB_DSN=postgresql+asyncpg://scanner:scanner@localhost:5432/scanner  # (ingest, engine, api, worker)

# --- Cache / streams / pubsub: Redis 7 (TDR §9) ----------------------------
SCANNER_REDIS_URL=redis://localhost:6379/0                                   # (ingest, engine, api, worker) [S2]

# --- Binance market-data provider (SLS §1–§2) ------------------------------
SCANNER_BINANCE_BASE_URL=https://api.binance.com     # REST base           (ingest)
SCANNER_BINANCE_WS_URL=wss://stream.binance.com:9443  # combined streams   (ingest) [S2]
SCANNER_BINANCE_WEIGHT_CAPACITY=1100                  # req-weight budget/min (ingest)

# --- Universe (dev convenience only; never a production knob, guide §26) ----
SCANNER_UNIVERSE_LIMIT=50                 # cap symbols in local dev      (ingest, engine) [S3]

# --- Observability (optional; disabled when unset) -------------------------
# error reporting; empty=off (all) [S0.3] — comment on its own line so the value stays truly empty
SCANNER_SENTRY_DSN=

# --- Public surface (staging/prod) -----------------------------------------
SCANNER_PUBLIC_HOST=staging.scanner.example   # Caddy/ACME + absolute URLs (api) [S0.3]
