# Staging/prod edge (TAD §22, §23; S0.2 §6.1).
# TLS is auto-provisioned. The frontend static site is served; /api/* proxies to
# the api process. /internal/* is BLOCKED at the edge — the API-Spec §18.18
# "never publicly routable" guarantee is enforced here, not hoped for.

{$SCANNER_PUBLIC_HOST:staging.scanner.example} {
	encode gzip

	# Security headers (TAD §23).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API Spec §18.18: internal endpoints are never publicly routable.
	#
	# Inside a `handle` block, not a bare `respond` with a matcher. Caddy orders
	# directives rather than reading them top to bottom, and `handle` runs
	# before `respond` -- so the catch-all `handle` below matched
	# `/internal/metrics` first, proxied it, and the guard never ran. Verified
	# against the running host: 200 before, 403 after. `handle` blocks are
	# mutually exclusive and evaluated in written order, which is the property
	# this needs.
	handle /internal/* {
		respond 403
	}

	# Request body limit (abuse guard).
	request_body {
		max_size 2MB
	}

	# API surface -> api process.
	handle /api/* {
		reverse_proxy api:8000
	}

	# Everything else -> the static SPA (client-side routing fallback).
	handle {
		reverse_proxy frontend:80
	}
}
