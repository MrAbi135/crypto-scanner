# Staging/prod edge (TAD §22, §23; S0.2 §6.1).
# TLS is auto-provisioned. The frontend static site is served; /api/* proxies to
# the api process. /internal/* is BLOCKED at the edge — the API-Spec §18.18
# "never publicly routable" guarantee is enforced here, not hoped for.

{$SCANNER_PUBLIC_HOST:staging.scanner.example} {
	encode gzip

	# Security headers (TAD §23).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Internal endpoints are never publicly routable.
	@internal path /internal/*
	respond @internal 403

	# Request body limit (abuse guard).
	request_body {
		max_size 2MB
	}

	# API surface -> api process.
	handle /api/* {
		reverse_proxy api:8000
	}

	# Everything else -> the static SPA (client-side routing fallback).
	handle {
		reverse_proxy frontend:80
	}
}
